<?xml version="1.0" encoding="utf-8"?>
<!--
    Тональные палитры Material 3, посчитанные из фирменных цветов Zindan:
    зеленый #223D2C (hue 154, тон 23) и золото #AA8843 (hue 83, тон 59).
    Тон = L* CIELAB, оттенок и насыщенность взяты в CIELCh и удерживаются постоянными.
    Генератор и таблица контрастов - .ai/crossprofile-fixes/design-verdict.md.

    Каждому токену обязана соответствовать пара в values-night/colors.xml.
-->
<resources>
    <!-- Material 3, светлая схема. Сдержанная системная синяя палитра. -->
    <color name="md_primary">#415F91</color>
    <color name="md_onPrimary">#FFFFFF</color>
    <color name="md_primaryContainer">#D6E3FF</color>
    <color name="md_onPrimaryContainer">#001B3E</color>
    <color name="md_inversePrimary">#AAC7FF</color>
    <color name="md_secondary">#565F71</color>
    <color name="md_onSecondary">#FFFFFF</color>
    <color name="md_secondaryContainer">#DAE2F9</color>
    <color name="md_onSecondaryContainer">#131C2B</color>
    <color name="md_tertiary">#705575</color>
    <color name="md_onTertiary">#FFFFFF</color>
    <color name="md_tertiaryContainer">#FAD8FD</color>
    <color name="md_onTertiaryContainer">#29132D</color>
    <color name="md_error">#B3261E</color>
    <color name="md_onError">#FFFFFF</color>
    <color name="md_errorContainer">#F9DEDC</color>
    <color name="md_onErrorContainer">#410E0B</color>
    <color name="md_background">#F9F9FF</color>
    <color name="md_onBackground">#1A1B20</color>
    <color name="md_surface">#F9F9FF</color>
    <color name="md_onSurface">#1A1B20</color>
    <color name="md_surfaceVariant">#E0E2EC</color>
    <color name="md_onSurfaceVariant">#43474E</color>
    <color name="md_surfaceContainerLowest">#FFFFFF</color>
    <color name="md_surfaceContainerLow">#F3F3FA</color>
    <color name="md_surfaceContainer">#EDEDF4</color>
    <color name="md_surfaceContainerHigh">#E7E8EE</color>
    <color name="md_surfaceContainerHighest">#E1E2E8</color>
    <color name="md_surfaceDim">#D9D9E0</color>
    <color name="md_surfaceBright">#F9F9FF</color>
    <color name="md_outline">#73777F</color>
    <color name="md_outlineVariant">#C3C6CF</color>
    <color name="md_inverseSurface">#2F3036</color>
    <color name="md_inverseOnSurface">#F1F0F7</color>
    <color name="md_scrim">#000000</color>
    <color name="md_surfaceTint">#415F91</color>

    <color name="brandBar">@color/md_surfaceContainer</color>
    <color name="brandBarOn">@color/md_onSurface</color>
    <color name="brandBarOnVariant">@color/md_onSurfaceVariant</color>
    <color name="brandBarIndicator">@color/md_secondaryContainer</color>
    <color name="brandBarRipple">#1F415F91</color>

    <!-- Мастер настройки -->
    <color name="setupWizardHeaderBackground">@color/md_primaryContainer</color>
    <color name="setupWizardHeaderText">@color/md_onPrimaryContainer</color>
    <color name="setupWizardHeaderProgress">@color/md_primary</color>
    <color name="setupWizardContentBackground">@color/md_surface</color>
    <color name="setupWizardContentText">@color/md_onSurface</color>
    <color name="setupWizardNavText">@color/md_primary</color>

    <!-- Состояния строки списка приложений -->
    <color name="selectedAppBackground">@color/md_secondaryContainer</color>
    <color name="selectedAndDisabledAppBackground">@color/md_tertiaryContainer</color>
    <color name="disabledAppBackground">@color/md_surfaceContainerHighest</color>
</resources>

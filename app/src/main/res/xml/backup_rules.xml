<?xml version="1.0" encoding="utf-8"?>
<!--
    То же самое для Android до 12, где действует fullBackupContent, а не
    data_extraction_rules: наружу не уезжает ничего. Причина та же: общий ключ
    подписи реле между профилями, см. data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

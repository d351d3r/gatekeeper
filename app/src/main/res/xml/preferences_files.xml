<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.preference.Preference
        android:key="settings_files_why"
        app:iconSpaceReserved="false"
        android:selectable="false"
        android:title="@string/settings_files_why"
        android:summary="@string/settings_files_why_desc" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="settings_cross_profile_file_chooser"
        app:iconSpaceReserved="false"
        android:title="@string/settings_cross_profile_file_chooser"
        android:summary="@string/settings_cross_profile_file_chooser_desc" />

    <androidx.preference.Preference
        android:dependency="settings_cross_profile_file_chooser"
        android:key="settings_external_file_manager"
        app:iconSpaceReserved="false"
        android:title="@string/settings_external_file_manager"
        android:summary="@string/settings_external_file_manager_desc" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="settings_cross_profile_content_access"
        app:iconSpaceReserved="false"
        android:title="@string/settings_cross_profile_content_access"
        android:summary="@string/settings_cross_profile_content_access_desc" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="settings_media_mirror"
        app:iconSpaceReserved="false"
        android:title="@string/media_exchange_title"
        android:summary="@string/media_exchange_explanation" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="media_exchange_screenshots"
        android:dependency="settings_media_mirror"
        app:iconSpaceReserved="false"
        android:title="@string/media_exchange_screenshots" />
    <androidx.preference.SwitchPreferenceCompat
        android:key="media_exchange_camera"
        android:dependency="settings_media_mirror"
        app:iconSpaceReserved="false"
        android:title="@string/media_exchange_camera" />
    <androidx.preference.Preference
        android:key="media_exchange_setup"
        android:dependency="settings_media_mirror"
        app:iconSpaceReserved="false"
        android:title="@string/media_exchange_allow"
        android:summary="@string/media_exchange_setup_desc" />
    <androidx.preference.Preference
        android:key="media_exchange_status"
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:title="@string/media_exchange_status" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="settings_share_work_to_personal"
        app:iconSpaceReserved="false"
        android:title="@string/settings_share_work_to_personal"
        android:summary="@string/settings_share_work_to_personal_desc" />

    <androidx.preference.Preference
        android:key="settings_files_how"
        app:iconSpaceReserved="false"
        android:selectable="false"
        android:title="@string/settings_files_how"
        android:summary="@string/settings_files_how_desc" />

    <androidx.preference.Preference
        android:key="settings_files_manager"
        app:iconSpaceReserved="false"
        android:selectable="false"
        android:title="@string/settings_files_manager"
        android:summary="@string/settings_files_manager_desc" />

</androidx.preference.PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/isolation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/setupWizardContentBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/setupWizardContentText"
                android:text="@string/isolation_setup_title" />

            <RadioGroup
                android:id="@+id/isolation_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/isolation_choice_convenient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/setupWizardContentText"
                    android:text="@string/isolation_preset_convenient" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginBottom="20dp"
                    android:lineSpacingMultiplier="1.1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:text="@string/isolation_preset_convenient_desc" />

                <RadioButton
                    android:id="@+id/isolation_choice_isolated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/setupWizardContentText"
                    android:text="@string/isolation_preset_isolated" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:lineSpacingMultiplier="1.1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:text="@string/isolation_preset_isolated_desc" />

            </RadioGroup>

            <TextView
                android:id="@+id/isolation_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/md_primary"
                android:text="@string/isolation_setup_advanced" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/isolation_done"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="24dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:text="@string/isolation_setup_done" />

</LinearLayout>
